{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dflippojr/agent-harness/docs/marketplace-manifest.schema.json",
  "title": "Agent Harness curated catalog manifest",
  "description": "Immutable per-version catalog record for a third-party app. Schema 1.0 is closed: additionalProperties is false everywhere. Unknown fields fail validation. Additive fields require manifest_schema_version 1.x; breaking changes require 2.0. See docs/marketplace-design.md. Never include daemon tokens, pairing codes, provider API keys, OAuth tokens, or login caches.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "app",
    "review"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": "1.0"
    },
    "app": {
      "$ref": "#/$defs/publisher_manifest"
    },
    "review": {
      "$ref": "#/$defs/review_record"
    }
  },
  "$defs": {
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/]+",
      "maxLength": 2048
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "daemon_api_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "GET /api/v1 api_version, currently 1.0 through 1.7. Path-major /api/v2 is out of range."
    },
    "app_scope": {
      "type": "string",
      "enum": [
        "sessions",
        "sessions:all",
        "approvals",
        "images",
        "inference",
        "remote_control"
      ],
      "description": "Current harness.apps.SCOPES. admin is an owner scope and is not permitted here."
    },
    "publisher_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_id",
        "version",
        "display_name",
        "summary",
        "publisher",
        "urls",
        "platforms",
        "min_daemon_api",
        "max_daemon_api",
        "artifacts",
        "license",
        "sbom",
        "monetization",
        "source_matches_distributed_build",
        "scopes",
        "browser_origins",
        "required_capabilities",
        "required_backends",
        "provider_auth",
        "network_destinations",
        "data_collected",
        "telemetry",
        "subprocesses",
        "filesystem_access",
        "handles_daemon_token"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?){1,4}$",
          "maxLength": 253,
          "description": "Immutable reverse-DNS id. Reserved prefixes: dev.agent-harness., com.agent-harness., agent-harness."
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$",
          "description": "SemVer 2.0. A published version string is never reused."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "website_url",
            "security_email",
            "support_email"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^pub-[0-9a-f]{12}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "website_url": {
              "$ref": "#/$defs/https_url"
            },
            "security_email": {
              "$ref": "#/$defs/email"
            },
            "support_email": {
              "$ref": "#/$defs/email"
            },
            "security_url": {
              "$ref": "#/$defs/https_url"
            }
          }
        },
        "urls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "release",
            "install",
            "uninstall",
            "privacy_policy",
            "issue_reporting"
          ],
          "properties": {
            "source": {
              "$ref": "#/$defs/https_url"
            },
            "release": {
              "$ref": "#/$defs/https_url"
            },
            "install": {
              "$ref": "#/$defs/https_url"
            },
            "uninstall": {
              "$ref": "#/$defs/https_url"
            },
            "privacy_policy": {
              "$ref": "#/$defs/https_url"
            },
            "issue_reporting": {
              "$ref": "#/$defs/https_url"
            }
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "os",
              "arch"
            ],
            "properties": {
              "os": {
                "enum": [
                  "windows",
                  "linux",
                  "macos",
                  "any"
                ]
              },
              "arch": {
                "enum": [
                  "x86_64",
                  "arm64",
                  "any"
                ]
              }
            }
          }
        },
        "min_daemon_api": {
          "$ref": "#/$defs/daemon_api_version"
        },
        "max_daemon_api": {
          "$ref": "#/$defs/daemon_api_version"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spdx"
          ],
          "properties": {
            "spdx": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9.+-]+$"
            },
            "url": {
              "$ref": "#/$defs/https_url"
            }
          }
        },
        "sbom": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "format"
          ],
          "properties": {
            "url": {
              "$ref": "#/$defs/https_url"
            },
            "format": {
              "enum": [
                "cyclonedx-json",
                "spdx-json"
              ]
            }
          }
        },
        "monetization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "disclosure",
            "commercial_use"
          ],
          "properties": {
            "model": {
              "enum": [
                "free",
                "donation",
                "paid_app",
                "subscription",
                "usage"
              ]
            },
            "price_usd": {
              "type": "number",
              "minimum": 0
            },
            "disclosure": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "commercial_use": {
              "enum": [
                "forbidden_by_publisher",
                "allowed",
                "unspecified"
              ],
              "description": "Publisher claim only. Neither the catalog nor the daemon can technically enforce it."
            }
          }
        },
        "source_matches_distributed_build": {
          "type": "boolean"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requested_scope"
          }
        },
        "browser_origins": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9.-]+(:[1-9][0-9]{0,4})?$",
            "description": "Exact origins as harness.apps.normalize_origin. HTTPS only in published records; loopback HTTP is not catalog-listable. No path, query, fragment, or credentials."
          }
        },
        "required_capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "modules"
          ],
          "properties": {
            "profile": {
              "enum": [
                "any",
                "full",
                "service"
              ]
            },
            "modules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "local_model",
                  "homelab",
                  "memory_library",
                  "images",
                  "jobs",
                  "gpu_guard",
                  "runners",
                  "remote_control",
                  "web",
                  "search",
                  "endpoint",
                  "notifications",
                  "backup"
                ]
              }
            }
          }
        },
        "required_backends": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "local",
              "claude",
              "codex",
              "cursor"
            ]
          }
        },
        "provider_auth": {
          "$ref": "#/$defs/provider_auth"
        },
        "network_destinations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/network_destination"
          }
        },
        "data_collected": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/data_item"
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "description"
          ],
          "properties": {
            "default": {
              "enum": [
                "off",
                "on"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "opt_out_url": {
              "$ref": "#/$defs/https_url"
            }
          }
        },
        "subprocesses": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "purpose",
              "persists_after_exit"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "persists_after_exit": {
                "type": "boolean"
              }
            }
          }
        },
        "filesystem_access": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "mode",
              "purpose"
            ],
            "properties": {
              "class": {
                "enum": [
                  "app_config",
                  "user_documents",
                  "arbitrary_picker",
                  "workspace_via_daemon_only"
                ]
              },
              "mode": {
                "enum": [
                  "read",
                  "write",
                  "readwrite"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          }
        },
        "handles_daemon_token": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storage",
            "description"
          ],
          "properties": {
            "storage": {
              "enum": [
                "os_keychain",
                "file_mode_0600",
                "memory_only"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "url",
        "sha256",
        "signature_status",
        "provenance_status"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._+-]+$"
        },
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature_status": {
          "enum": [
            "unsigned",
            "signed"
          ]
        },
        "provenance_status": {
          "enum": [
            "none",
            "slsa",
            "in_toto"
          ]
        },
        "signature_url": {
          "$ref": "#/$defs/https_url"
        },
        "public_key_url": {
          "$ref": "#/$defs/https_url"
        },
        "provenance_url": {
          "$ref": "#/$defs/https_url"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "signature_status": {
                "const": "signed"
              }
            },
            "required": [
              "signature_status"
            ]
          },
          "then": {
            "required": [
              "signature_url",
              "public_key_url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "provenance_status": {
                "enum": [
                  "slsa",
                  "in_toto"
                ]
              }
            },
            "required": [
              "provenance_status"
            ]
          },
          "then": {
            "required": [
              "provenance_url"
            ]
          }
        }
      ]
    },
    "requested_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "justification",
        "risk_tier"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/app_scope"
        },
        "justification": {
          "type": "string",
          "minLength": 40,
          "maxLength": 1000
        },
        "risk_tier": {
          "enum": [
            "standard",
            "elevated"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "enum": [
                  "sessions:all",
                  "approvals",
                  "remote_control"
                ]
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "risk_tier": {
                "const": "elevated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "enum": [
                  "sessions",
                  "images",
                  "inference"
                ]
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "risk_tier": {
                "const": "standard"
              }
            }
          }
        }
      ]
    },
    "provider_auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "never_handles_provider_credentials",
        "modes",
        "usage_disclosure"
      ],
      "properties": {
        "never_handles_provider_credentials": {
          "const": true,
          "description": "Required true. The app never collects, stores, relays, or displays provider API keys, OAuth tokens, or login caches. Owner assigns keys only through /api/admin/v1/provider-credentials."
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "policy",
              "classification"
            ],
            "properties": {
              "backend": {
                "enum": [
                  "local",
                  "claude",
                  "codex",
                  "cursor"
                ]
              },
              "policy": {
                "enum": [
                  "none",
                  "api_key",
                  "subscription",
                  "subscription_then_api_key"
                ],
                "description": "Matches owner-assigned harness policies. none is for local-only. subscription modes are marketplace-revocable and are not implied by CLI capability."
              },
              "classification": {
                "enum": [
                  "provider_fact",
                  "marketplace_policy",
                  "unresolved"
                ]
              },
              "notes": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        },
        "usage_disclosure": {
          "type": "string",
          "minLength": 40,
          "maxLength": 2000
        }
      }
    },
    "network_destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "host",
        "scheme",
        "port",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "host": {
          "type": "string",
          "pattern": "^(?:\\*\\.)?[A-Za-z0-9.-]+$",
          "maxLength": 253,
          "description": "Exact host or a single leading *. label. Bare * is invalid."
        },
        "scheme": {
          "enum": [
            "https"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "data_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "sent_to",
        "retained",
        "purpose"
      ],
      "properties": {
        "category": {
          "enum": [
            "session_prompt",
            "session_transcript",
            "approval_payload",
            "image",
            "local_file",
            "identifier",
            "other"
          ]
        },
        "sent_to": {
          "type": "string",
          "maxLength": 64,
          "description": "local_only or a network_destinations id."
        },
        "retained": {
          "enum": [
            "none",
            "session",
            "until_account_delete",
            "publisher_defined"
          ]
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      },
      "if": {
        "properties": {
          "retained": {
            "const": "publisher_defined"
          }
        },
        "required": [
          "retained"
        ]
      },
      "then": {
        "required": [
          "retention_days"
        ]
      }
    },
    "review_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "checklist_version",
        "reviewed_at",
        "reviewer_ids",
        "evidence_urls",
        "publisher_manifest_sha256",
        "artifact_digests",
        "permission_diff",
        "provider_policy_labels"
      ],
      "properties": {
        "decision": {
          "enum": [
            "approved",
            "rejected",
            "publish"
          ]
        },
        "checklist_version": {
          "type": "string",
          "const": "1.0"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^rev-[0-9a-f]{8}$"
          }
        },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/https_url"
          }
        },
        "publisher_manifest_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the UTF-8 JSON for app with sorted keys and separators (',', ':')."
        },
        "artifact_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filename",
              "sha256"
            ],
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "permission_diff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "summary"
          ],
          "properties": {
            "kind": {
              "enum": [
                "initial",
                "unexpanded",
                "expansion"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "provider_policy_labels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend",
              "classification"
            ],
            "properties": {
              "backend": {
                "enum": [
                  "local",
                  "claude",
                  "codex",
                  "cursor"
                ]
              },
              "classification": {
                "enum": [
                  "provider_fact",
                  "marketplace_policy",
                  "unresolved"
                ]
              },
              "notes": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    }
  }
}
