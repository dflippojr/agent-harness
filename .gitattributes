# Files copied to the MacBook must keep LF endings (Git for Windows defaults to autocrlf=true).
*.sh text eol=lf
install/** text eol=lf
macrunner/** text eol=lf
# Files read inside Linux containers must keep LF endings (Git for Windows defaults to autocrlf).
ops/egress/** text eol=lf
sandbox/** text eol=lf
# The pinned gitleaks rules (harness/gitleaks/pin.json) must hash the same on every checkout.
harness/gitleaks/** text eol=lf
